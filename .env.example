NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=wellora
POSTGRES_USER=wellora_owner
POSTGRES_PASSWORD=replace-with-an-owner-password
APP_DATABASE_USER=wellora_app
APP_DATABASE_PASSWORD=replace-with-an-independent-runtime-password
POSTGRES_PORT=5432
MIGRATION_DATABASE_URL=postgresql://wellora_owner:replace-with-an-owner-password@localhost:5432/wellora?schema=public
DATABASE_URL=postgresql://wellora_app:replace-with-an-independent-runtime-password@localhost:5432/wellora?schema=public
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=3000

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_KEY_ID=local-v1
JWT_ACCESS_PREVIOUS_KEYS={}
JWT_ISSUER=wellora-marketplace
JWT_AUDIENCE=wellora-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=900
EMAIL_VERIFICATION_TTL_SECONDS=86400
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
AUTH_METADATA_SECRET=replace-with-a-different-32-character-secret
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_IP_MAX=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_PUBLIC_RESPONSE_MIN_MS=150
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
