generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum OneTimeTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EmployerMembershipRole {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProviderMembershipRole {
  ADMIN
  STAFF
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @db.VarChar(320)
  normalizedEmail   String        @unique @map("normalized_email") @db.VarChar(320)
  passwordHash      String        @map("password_hash") @db.Text
  status            AccountStatus @default(PENDING_VERIFICATION)
  platformRole      PlatformRole? @map("platform_role")
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            AuthSession[]
  oneTimeTokens       OneTimeToken[]
  employerMemberships EmployerMembership[]
  employeeProfiles    Employee[]
  providerMemberships ProviderMembership[]

  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceName       String?   @map("device_name") @db.VarChar(120)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipHash           String?   @map("ip_hash") @db.Char(64)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(80)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  secretHash        String    @map("secret_hash") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       OneTimeTokenType
  secretHash String           @map("secret_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?        @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("one_time_tokens")
}

model Employer {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(160)
  slug            String             @db.VarChar(120)
  normalizedSlug  String             @unique @map("normalized_slug") @db.VarChar(120)
  status          OrganizationStatus @default(PENDING)
  country         String             @db.Char(2)
  timezone        String             @db.VarChar(64)
  defaultCurrency String             @map("default_currency") @db.Char(3)
  contactEmail    String?            @map("contact_email") @db.VarChar(320)
  contactPhone    String?            @map("contact_phone") @db.VarChar(32)
  websiteUrl      String?            @map("website_url") @db.VarChar(2048)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships EmployerMembership[]
  employees   Employee[]

  @@index([status, name, id])
  @@index([country, status])
  @@map("employers")
}

model EmployerMembership {
  id         String                 @id @default(uuid()) @db.Uuid
  employerId String                 @map("employer_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  role       EmployerMembershipRole
  status     MembershipStatus       @default(ACTIVE)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([employerId, userId])
  @@index([userId, status, role])
  @@index([employerId, role, status])
  @@map("employer_memberships")
}

model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  employerId      String         @map("employer_id") @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  email           String         @db.VarChar(320)
  normalizedEmail String         @map("normalized_email") @db.VarChar(320)
  firstName       String         @map("first_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)
  employeeNumber  String?        @map("employee_number") @db.VarChar(80)
  department      String?        @db.VarChar(120)
  jobTitle        String?        @map("job_title") @db.VarChar(120)
  status          EmployeeStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([employerId, normalizedEmail])
  @@unique([employerId, userId])
  @@unique([employerId, employeeNumber])
  @@index([employerId, status, lastName, firstName, id])
  @@index([userId, status])
  @@index([employerId, department, status])
  @@map("employees")
}

model Provider {
  id                String             @id @default(uuid()) @db.Uuid
  businessName      String             @map("business_name") @db.VarChar(160)
  slug              String             @db.VarChar(120)
  normalizedSlug    String             @unique @map("normalized_slug") @db.VarChar(120)
  description       String?            @db.Text
  status            OrganizationStatus @default(PENDING)
  country           String             @db.Char(2)
  timezone          String             @db.VarChar(64)
  contactEmail      String?            @map("contact_email") @db.VarChar(320)
  contactPhone      String?            @map("contact_phone") @db.VarChar(32)
  websiteUrl        String?            @map("website_url") @db.VarChar(2048)
  commissionRateBps Int                @map("commission_rate_bps") @db.SmallInt
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships ProviderMembership[]

  @@index([status, businessName, id])
  @@index([country, status])
  @@map("providers")
}

model ProviderMembership {
  id         String                 @id @default(uuid()) @db.Uuid
  providerId String                 @map("provider_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  role       ProviderMembershipRole
  status     MembershipStatus       @default(ACTIVE)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([providerId, userId])
  @@index([userId, status, role])
  @@index([providerId, role, status])
  @@map("provider_memberships")
}
