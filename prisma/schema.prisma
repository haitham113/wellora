generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum OneTimeTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EmployerMembershipRole {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProviderMembershipRole {
  ADMIN
  STAFF
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ActivityLocationType {
  ONSITE
  ONLINE
  HYBRID
}

enum ActivityMediaType {
  IMAGE
  VIDEO
}

enum ActivitySessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum DstOverlapPolicy {
  EARLIER
  LATER
}

enum DstGapPolicy {
  SKIP
}

enum AllowanceTransactionType {
  INITIAL_ALLOCATION
  TOP_UP
  BOOKING_DEBIT
  CANCELLATION_REFUND
  MANUAL_ADJUSTMENT
  EXPIRATION
}

enum AllowanceReferenceType {
  ALLOWANCE_GRANT
  BOOKING
  MANUAL_ADJUSTMENT
  EXPIRATION_POLICY
}

enum LedgerActorType {
  USER
  SYSTEM
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @db.VarChar(320)
  normalizedEmail   String        @unique @map("normalized_email") @db.VarChar(320)
  passwordHash      String        @map("password_hash") @db.Text
  status            AccountStatus @default(PENDING_VERIFICATION)
  platformRole      PlatformRole? @map("platform_role")
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                  AuthSession[]
  oneTimeTokens             OneTimeToken[]
  employerMemberships       EmployerMembership[]
  employeeProfiles          Employee[]
  providerMemberships       ProviderMembership[]
  cancelledActivitySessions ActivitySession[]      @relation("ActivitySessionCancelledBy")
  allowanceTransactions     AllowanceTransaction[] @relation("AllowanceTransactionActor")
  auditLogs                 AuditLog[]             @relation("AuditLogActor")

  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceName       String?   @map("device_name") @db.VarChar(120)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipHash           String?   @map("ip_hash") @db.Char(64)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?   @map("revocation_reason") @db.VarChar(80)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  secretHash        String    @map("secret_hash") @db.Text
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model OneTimeToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       OneTimeTokenType
  secretHash String           @map("secret_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?        @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("one_time_tokens")
}

model Employer {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(160)
  slug            String             @db.VarChar(120)
  normalizedSlug  String             @unique @map("normalized_slug") @db.VarChar(120)
  status          OrganizationStatus @default(PENDING)
  country         String             @db.Char(2)
  timezone        String             @db.VarChar(64)
  defaultCurrency String             @map("default_currency") @db.Char(3)
  contactEmail    String?            @map("contact_email") @db.VarChar(320)
  contactPhone    String?            @map("contact_phone") @db.VarChar(32)
  websiteUrl      String?            @map("website_url") @db.VarChar(2048)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships       EmployerMembership[]
  employees         Employee[]
  allowanceAccounts AllowanceAccount[]

  @@index([status, name, id])
  @@index([country, status])
  @@map("employers")
}

model EmployerMembership {
  id         String                 @id @default(uuid()) @db.Uuid
  employerId String                 @map("employer_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  role       EmployerMembershipRole
  status     MembershipStatus       @default(ACTIVE)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([employerId, userId])
  @@index([userId, status, role])
  @@index([employerId, role, status])
  @@map("employer_memberships")
}

model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  employerId      String         @map("employer_id") @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  email           String         @db.VarChar(320)
  normalizedEmail String         @map("normalized_email") @db.VarChar(320)
  firstName       String         @map("first_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)
  employeeNumber  String?        @map("employee_number") @db.VarChar(80)
  department      String?        @db.VarChar(120)
  jobTitle        String?        @map("job_title") @db.VarChar(120)
  status          EmployeeStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  employer         Employer          @relation(fields: [employerId], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  allowanceAccount AllowanceAccount?

  @@unique([id, employerId])
  @@unique([employerId, normalizedEmail])
  @@unique([employerId, userId])
  @@unique([employerId, employeeNumber])
  @@index([employerId, status, lastName, firstName, id])
  @@index([userId, status])
  @@index([employerId, department, status])
  @@map("employees")
}

model Provider {
  id                String             @id @default(uuid()) @db.Uuid
  businessName      String             @map("business_name") @db.VarChar(160)
  slug              String             @db.VarChar(120)
  normalizedSlug    String             @unique @map("normalized_slug") @db.VarChar(120)
  description       String?            @db.Text
  status            OrganizationStatus @default(PENDING)
  country           String             @db.Char(2)
  timezone          String             @db.VarChar(64)
  contactEmail      String?            @map("contact_email") @db.VarChar(320)
  contactPhone      String?            @map("contact_phone") @db.VarChar(32)
  websiteUrl        String?            @map("website_url") @db.VarChar(2048)
  commissionRateBps Int                @map("commission_rate_bps") @db.SmallInt
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships ProviderMembership[]
  activities  Activity[]

  @@index([status, businessName, id])
  @@index([country, status])
  @@map("providers")
}

model ProviderMembership {
  id         String                 @id @default(uuid()) @db.Uuid
  providerId String                 @map("provider_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  role       ProviderMembershipRole
  status     MembershipStatus       @default(ACTIVE)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([providerId, userId])
  @@index([userId, status, role])
  @@index([providerId, role, status])
  @@map("provider_memberships")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(120)
  slug           String   @db.VarChar(120)
  normalizedSlug String   @unique @map("normalized_slug") @db.VarChar(120)
  description    String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  displayOrder   Int      @default(0) @map("display_order") @db.SmallInt
  searchText     String   @default(dbgenerated()) @map("search_text") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  activities Activity[]

  @@index([isActive, displayOrder, name, id])
  @@map("categories")
}

model Activity {
  id                        String                @id @default(uuid()) @db.Uuid
  providerId                String                @map("provider_id") @db.Uuid
  categoryId                String                @map("category_id") @db.Uuid
  title                     String                @db.VarChar(160)
  slug                      String                @db.VarChar(120)
  normalizedSlug            String                @map("normalized_slug") @db.VarChar(120)
  shortDescription          String?               @map("short_description") @db.VarChar(500)
  fullDescription           String?               @map("full_description") @db.Text
  priceMinor                BigInt?               @map("price_minor") @db.BigInt
  currency                  String?               @db.Char(3)
  durationMinutes           Int?                  @map("duration_minutes") @db.SmallInt
  locationType              ActivityLocationType? @map("location_type")
  venueName                 String?               @map("venue_name") @db.VarChar(160)
  addressLine1              String?               @map("address_line_1") @db.VarChar(200)
  addressLine2              String?               @map("address_line_2") @db.VarChar(200)
  city                      String?               @db.VarChar(120)
  normalizedCity            String?               @map("normalized_city") @db.VarChar(120)
  region                    String?               @db.VarChar(120)
  postalCode                String?               @map("postal_code") @db.VarChar(32)
  country                   String?               @db.Char(2)
  onlineUrl                 String?               @map("online_url") @db.VarChar(2048)
  status                    ActivityStatus        @default(DRAFT)
  minParticipants           Int?                  @map("min_participants") @db.SmallInt
  maxParticipants           Int?                  @map("max_participants") @db.SmallInt
  cancellationPolicy        String?               @map("cancellation_policy") @db.Text
  cancellationWindowMinutes Int?                  @map("cancellation_window_minutes")
  bookingCutoffMinutes      Int?                  @map("booking_cutoff_minutes")
  searchText                String                @default(dbgenerated()) @map("search_text") @db.Text
  publishedAt               DateTime?             @map("published_at") @db.Timestamptz(3)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  provider          Provider                   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category          Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  media             ActivityMedia[]
  sessions          ActivitySession[]
  scheduleTemplates ActivityScheduleTemplate[]

  @@unique([providerId, normalizedSlug])
  @@index([providerId, status, createdAt, id])
  @@index([providerId, status, priceMinor, id])
  @@index([providerId, status, title, id])
  @@index([providerId, status, durationMinutes, id])
  @@index([status, publishedAt, id])
  @@index([status, currency, priceMinor, id])
  @@index([status, title, id])
  @@index([status, durationMinutes, id])
  @@index([status, categoryId, publishedAt, id])
  @@index([status, providerId, publishedAt, id])
  @@index([status, locationType, country, normalizedCity, publishedAt, id], map: "activities_status_location_published_at_id_idx")
  @@map("activities")
}

model ActivityMedia {
  id           String            @id @default(uuid()) @db.Uuid
  activityId   String            @map("activity_id") @db.Uuid
  type         ActivityMediaType
  url          String            @db.VarChar(2048)
  altText      String?           @map("alt_text") @db.VarChar(240)
  displayOrder Int               @default(0) @map("display_order") @db.SmallInt
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, displayOrder, id])
  @@map("activity_media")
}

model ActivityScheduleTemplate {
  id                   String           @id @default(uuid()) @db.Uuid
  activityId           String           @map("activity_id") @db.Uuid
  timezone             String           @db.VarChar(64)
  localStartTime       String           @map("local_start_time") @db.Char(5)
  weekdays             Int[]
  intervalWeeks        Int              @default(1) @map("interval_weeks") @db.SmallInt
  generationStartDate  DateTime         @map("generation_start_date") @db.Date
  generationEndDate    DateTime         @map("generation_end_date") @db.Date
  durationMinutes      Int              @map("duration_minutes") @db.SmallInt
  capacity             Int              @db.SmallInt
  bookingCutoffMinutes Int              @map("booking_cutoff_minutes")
  dstOverlapPolicy     DstOverlapPolicy @default(EARLIER) @map("dst_overlap_policy")
  dstGapPolicy         DstGapPolicy     @default(SKIP) @map("dst_gap_policy")
  lastGeneratedAt      DateTime?        @map("last_generated_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity Activity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  sessions ActivitySession[]

  @@unique([id, activityId], map: "activity_schedule_templates_id_activity_id_key")
  @@index([activityId, generationStartDate, generationEndDate, id], map: "activity_schedule_templates_activity_window_id_idx")
  @@map("activity_schedule_templates")
}

model ActivitySession {
  id                   String                @id @default(uuid()) @db.Uuid
  activityId           String                @map("activity_id") @db.Uuid
  scheduleTemplateId   String?               @map("schedule_template_id") @db.Uuid
  startsAt             DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime              @map("ends_at") @db.Timestamptz(3)
  timezone             String                @db.VarChar(64)
  utcOffsetMinutes     Int                   @map("utc_offset_minutes") @db.SmallInt
  utcEndOffsetMinutes  Int                   @map("utc_end_offset_minutes") @db.SmallInt
  capacity             Int                   @db.SmallInt
  bookedCount          Int                   @default(0) @map("booked_count") @db.SmallInt
  bookingCutoffMinutes Int                   @map("booking_cutoff_minutes")
  bookingCutoffAt      DateTime              @map("booking_cutoff_at") @db.Timestamptz(3)
  status               ActivitySessionStatus @default(SCHEDULED)
  cancellationReason   String?               @map("cancellation_reason") @db.VarChar(500)
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId    String?               @map("cancelled_by_user_id") @db.Uuid
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz(3)
  version              Int                   @default(0)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity         Activity                  @relation(fields: [activityId], references: [id], onDelete: Restrict)
  scheduleTemplate ActivityScheduleTemplate? @relation(fields: [scheduleTemplateId, activityId], references: [id, activityId], onDelete: Restrict)
  cancelledBy      User?                     @relation("ActivitySessionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@unique([activityId, startsAt])
  @@index([activityId, status, startsAt, id])
  @@index([status, bookingCutoffAt, startsAt, id], map: "activity_sessions_status_cutoff_starts_id_idx")
  @@index([scheduleTemplateId, startsAt, id])
  @@index([cancelledByUserId, cancelledAt])
  @@map("activity_sessions")
}

model AllowanceAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  employerId          String   @map("employer_id") @db.Uuid
  employeeId          String   @unique @map("employee_id") @db.Uuid
  currency            String   @db.Char(3)
  currentBalanceMinor BigInt   @default(0) @map("current_balance_minor") @db.BigInt
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employer     Employer               @relation(fields: [employerId], references: [id], onDelete: Restrict)
  employee     Employee               @relation(fields: [employeeId, employerId], references: [id, employerId], onDelete: Restrict)
  transactions AllowanceTransaction[]

  @@unique([employeeId, employerId])
  @@index([employerId, employeeId])
  @@map("allowance_accounts")
}

model AllowanceTransaction {
  id                    String                   @id @default(uuid()) @db.Uuid
  accountId             String                   @map("account_id") @db.Uuid
  sequence              Int
  type                  AllowanceTransactionType
  amountDeltaMinor      BigInt                   @map("amount_delta_minor") @db.BigInt
  resultingBalanceMinor BigInt                   @map("resulting_balance_minor") @db.BigInt
  currency              String                   @db.Char(3)
  referenceType         AllowanceReferenceType   @map("reference_type")
  referenceId           String                   @map("reference_id") @db.Uuid
  metadata              Json?                    @db.JsonB
  actorType             LedgerActorType          @map("actor_type")
  actorUserId           String?                  @map("actor_user_id") @db.Uuid
  correlationId         String                   @map("correlation_id") @db.VarChar(128)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  account  AllowanceAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  actor    User?            @relation("AllowanceTransactionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  auditLog AuditLog?

  @@unique([accountId, sequence])
  @@unique([accountId, type, referenceType, referenceId], map: "allowance_transactions_reference_key")
  @@index([accountId, createdAt, id])
  @@index([referenceType, referenceId])
  @@index([actorUserId, createdAt])
  @@map("allowance_transactions")
}

model AuditLog {
  id                     String   @id @default(uuid()) @db.Uuid
  actorUserId            String   @map("actor_user_id") @db.Uuid
  action                 String   @db.VarChar(80)
  entityType             String   @map("entity_type") @db.VarChar(80)
  entityId               String   @map("entity_id") @db.Uuid
  allowanceTransactionId String?  @unique @map("allowance_transaction_id") @db.Uuid
  beforeState            Json?    @map("before_state") @db.JsonB
  afterState             Json?    @map("after_state") @db.JsonB
  correlationId          String   @map("correlation_id") @db.VarChar(128)
  requestMetadata        Json?    @map("request_metadata") @db.JsonB
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor                User                  @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  allowanceTransaction AllowanceTransaction? @relation(fields: [allowanceTransactionId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
